                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4199/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "b2ee1c6eba158428afb0f693a233a29ab9c55288589769be8671afce1058b7c2",
