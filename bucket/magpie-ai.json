                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4909/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "99aa3f66f3262aded49e8d20f15d8ad60d4e1f054e061cd02a14c89142e1085d",
