                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4520/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "86081d2f063d60058fa769edc80f9e8b3e7d7667355abb3c72486f977383bc7a",
                "820d88e2c56aef9024b04353cfee9acb7c50ac7d3dc8aad88733130f71fde21f"
