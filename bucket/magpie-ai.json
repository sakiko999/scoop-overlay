                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4985/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "17452498a0f89ac27bb3722db69913bebcaf70ec58a3522bb148752613e78e2c",
