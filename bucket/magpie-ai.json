                "https://github.com/yetone/magpie-releases/releases/download/v0.1.3921/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "712ce939b257862d10028f25d2c9b5c94e1d222d59e658497e9db4cfb5e831a2",
