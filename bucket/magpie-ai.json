                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4656/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "7a959ac940ab033b88d3918ae53a10818a075aa9c9e93b4a845692e9b5e819ee",
