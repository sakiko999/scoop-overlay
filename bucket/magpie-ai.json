                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4501/magpie-windows-arm64.exe#/magpie.exe",
                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4501/magpie-cli-windows-arm64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "1491e460f84b9f0cb88d109fcf2d00dfc90af0f6dc78c88cb33691e146f86301",
