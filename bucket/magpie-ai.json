                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4137/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "714f69c370be43a9c2505bd3f849660239e9f2b320b068d7d50db5c01a366f37",
