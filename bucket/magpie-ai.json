                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4501/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "a9327237bbb4639ee53f73c5afcb163d6e085a85681e10206501ef6da4014477",
                "bbe313253b7bfa778e347ba02d352af4ab00b04b212a9ae9b2bf2a6fa565d79b"
            ]
        },
        "arm64": {
