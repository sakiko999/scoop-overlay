                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4994/magpie-windows-amd64.exe#/magpie.exe",
                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4994/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "5963af394ec8e71423631041b3e7d72240e48288614f0fa9ce874cffd98a71d5",
                "2052a8a1a9a5b5e2f1bf2a46c82b3735937852a7a830d551982533a96af44941"
            ]
        },
        "arm64": {
            "url": [
                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4994/magpie-windows-arm64.exe#/magpie.exe",
                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4994/magpie-cli-windows-arm64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "48065c96ec74bc02bdb44e1f34b3ac1669b760ba3e9c2e1c5e1f44fe603027ce",
