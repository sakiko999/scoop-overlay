                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4353/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "3aa865408f652217c2b5af31156a5ff2d7cc272a4c9602ba278677adf77200ea",
