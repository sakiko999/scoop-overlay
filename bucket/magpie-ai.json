                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4400/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "cb05eb65b31a6a7da93171642a3e94c78ea591e3c21e9fe6bff1f9497a960315",
