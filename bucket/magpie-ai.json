                "https://github.com/yetone/magpie-releases/releases/download/v0.1.4245/magpie-cli-windows-amd64.exe#/magpie-cli.exe"
            ],
            "hash": [
                "961a5627a020dc397f77f011bde1679b65dca0abdc9e2832386f39083c41b112",
